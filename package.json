{
  "name": "zurashitabi-development-environment",
  "version": "0.0.0",
  "private": true,
  "description": "Shared v3 contract, authenticated API skeleton and bilingual mock UI.",
  "engines": {
    "node": ">=24.22.2 <25",
    "npm": ">=11.19.1 <12"
  },
  "packageManager": "npm@11.19.1",
  "volta": {
    "node": "24.22.2",
    "npm": "11.19.1"
  },
  "scripts": {
    "setup": "node scripts/setup-env.mjs",
    "doctor": "node scripts/doctor.mjs",
    "verify:env": "node scripts/verify-env.mjs",
    "emulators": "node scripts/firebase-local.mjs start",
    "verify:emulators": "node scripts/firebase-local.mjs verify",
    "test:firestore": "node scripts/firebase-local.mjs backend-test",
    "verify:local-flow": "node scripts/verify-local-flow.mjs",
    "verify:curated-flow": "node scripts/verify-local-flow.mjs --curated",
    "dev:frontend": "node scripts/run-app.mjs frontend",
    "dev:backend": "node scripts/run-app.mjs backend",
    "verify:foundation": "node scripts/verify-foundation.mjs",
    "data:check": "node scripts/check-data.mjs",
    "check:frontend": "node scripts/check-frontend.mjs",
    "test:setup": "node --test scripts/tests/download.test.mjs"
  },
  "devDependencies": {
    "firebase-tools": "15.34.2"
  }
}
