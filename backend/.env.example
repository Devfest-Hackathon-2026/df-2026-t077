# Local-only defaults; no real project or credentials.
APP_ENV=local
DATA_MODE=demo
GCP_PROJECT_ID=demo-zurashitabi
# Vertex AI: pass GCP_PROJECT_ID/GCP_LOCATION/GEMINI_MODEL to the SDK explicitly.
# Auth is ADC locally and the Cloud Run service account when deployed; never a key JSON.
# Real project (zurashitabi) goes only in your own backend/.env, with the emulator hosts removed.
GCP_LOCATION=global
GEMINI_MODEL=gemini-3.8-flash
# template: planner text only. gemini: Fact-grounded summaries via Vertex AI (needs GCP_PROJECT_ID/GEMINI_MODEL).
EXPLANATION_PROVIDER=template
CORS_ORIGINS=http://127.0.0.1:5173
GENERATION_TIMEOUT_SECONDS=25
PORT=8000
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# Local/emulator: (default). The real project uses the named Tokyo database: FIRESTORE_DATABASE=zurashitabi
FIRESTORE_DATABASE=(default)
MAPS_API_KEY=
