# Development mock defaults. Use VITE_USE_MOCKS=false and VITE_AREA_ID=nagoya-central with a curated backend for real Nagoya data.
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_USE_MOCKS=true
VITE_MOCK_SCENARIO=normal
VITE_USE_FIREBASE_EMULATORS=true
VITE_FIREBASE_PROJECT_ID=demo-zurashitabi
VITE_FIREBASE_API_KEY=demo-only-not-a-real-key
VITE_FIREBASE_AUTH_DOMAIN=demo-zurashitabi.firebaseapp.com
VITE_GOOGLE_MAPS_API_KEY=
# The backend-configured area ID. Set this before using the real API.
VITE_AREA_ID=
