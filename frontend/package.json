{
  "name": "zurashitabi-frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.22.2 <25"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "build": "vite build",
    "api:types": "openapi-typescript ../contracts/openapi.json -o src/api/schema.d.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test:e2e": "playwright test",
    "test:maps": "playwright test --config playwright.maps.config.ts",
    "test:live": "playwright test --config playwright.live.config.ts",
    "preview": "vite preview",
    "test:unit": "playwright test --config playwright.unit.config.ts"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.5",
    "@tanstack/react-query": "5.105.3",
    "react-hook-form": "7.91.0",
    "@hookform/resolvers": "7.0.2",
    "zod": "4.6.7",
    "firebase": "13.2.0",
    "@vis.gl/react-google-maps": "1.10.2",
    "openapi-fetch": "0.17.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "msw": "3.0.3",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.7"
  }
}
